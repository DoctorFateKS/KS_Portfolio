<section class="main-section">
  <div class="halftone"></div>
  <div class="action-lines"></div>

  <div class="container">
    <div class="header">
      <div class="header-line"></div>
			<span class="header-jp">アートギャラリー</span>
			<span class="header-en">Ma Galerie d'Art</span>
		</div>

    <h1 class="skills-title"><span class="fg">Grimoire</span> des <span class="highlight">Projets</span></h1>
    <p class="skills-intro">Chaque projet est une nouvelle aventure avec mes acolytes <span class="emphasis">Ruby</span> et <span class="emphasis">Ruby on Rails</span>. Chacun d'eux a été réalisé en respectant au mieux les principes d'architectures d'applications et une méthodologie de tests rigoureuse.</p>

    <div class="projects-grid">
      <% @projects.each do |project| %>
        <article class="skills-card">
          <div class="card-ribbon"></div>
          <header class="project-card-head">
            <div class="card-title">
              <h3><%= project.title %></h3>
              <div class="project-subtitle">
                <span class="jp-subtitle"><%= project.role_jp %></span> <span class="project-highlight">— <%= project.role_description %></span>
              </div>
            </div>
            <div class="social-icons">
              <%= link_to project.github_url, class: "social-icon" do %><i class="fa-brands fa-github"></i><% end %>
              <%= link_to project.demo_url, class: "social-icon" do %><i class="fa-solid fa-arrow-right-to-bracket"></i><% end %>
            </div>
          </header>
          <div class="project-card-body">
            <p class="tagline"><%= project.tagline %></p>
            <div>
              <span class="challenge-title">Challenges</span>
              <p class="challenge"><%= project.challenges %></p>
            </div>
            <div class="stack">
              <p>
                <% project.stack.split(",").each do |techno| %>
                  <span class="techno"><%= techno %></span>
                <% end %>
              </p>
            </div>
          </div>
          <footer class="project-card-footer">
            <div class="results">
              <div class="results-item">
                <% project.results.split(",").first(3).each do |result| %>
                  <div class="results-square"></div>
                  <span class="result"><%= result %></span>
                <% end %>
              </div>
            </div>
            <%= link_to project_path(project), class: "details-link" do %>Détails <i class="fa-solid fa-arrow-right"></i><% end %>
          </footer>
        </article>
      <% end %>
    </div>
  </div>
</section>
