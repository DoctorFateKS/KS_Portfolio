<div class="page-content">
  <section class="page-section">
    <div class="halftone" aria-hidden="true"></div>
    <div class="action-lines" aria-hidden="true"></div>

    <div class="container">

      <div class="header">
        <div class="header-line"></div>
        <span class="header-jp">作品</span>
        <span class="header-en">Réalisations</span>
      </div>

      <h1 class="projects-title"><span class="fg">Mes</span> <span class="highlight">Réalisations</span></h1>
      <p class="projects-intro">
        Chaque projet ci-dessous a été mené avec la même exigence : une architecture réfléchie,
        une couverture de tests sérieuse avec <span class="emphasis">RSpec</span>, et un code que
        je suis prêt à défendre en revue. Voici un aperçu de mes réalisations en
        <span class="emphasis">Ruby on Rails</span>.
      </p>

      <% if params[:tag].present? %>
        <div class="projects-filter-banner">
          Filtré par <strong><%= params[:tag] %></strong>
          <%= link_to "Voir toutes les réalisations", projects_path, class: "projects-filter-banner__clear" %>
        </div>
      <% end %>

      <% if @projects.blank? %>
        <p class="projects-empty">
          <% if params[:tag].present? %>
            Aucune réalisation ne correspond à ce filtre pour le moment.
          <% else %>
            Aucune réalisation publiée pour le moment — revenez bientôt !
          <% end %>
        </p>
      <% else %>
        <div class="projects-carousel" data-controller="carousel">
          <button
            type="button"
            class="projects-carousel__arrow projects-carousel__arrow--prev"
            data-carousel-target="prevButton"
            data-action="click->carousel#prev"
            aria-label="Réalisations précédentes"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>

          <div
            class="projects-carousel__track"
            data-controller="reveal"
            data-carousel-target="track"
            data-reveal-root-selector-value=".projects-carousel__track"
            tabindex="0"
            role="region"
            aria-label="Réalisations, liste défilante horizontalement"
            data-action="keydown.left->carousel#prev keydown.right->carousel#next"
          >
            <% @projects.each do |project| %>
              <article class="project-card" data-carousel-target="card" data-reveal-target="item">
                <div class="card-ribbon" aria-hidden="true"></div>

                <div class="project-card-thumb">
                  <% if project.respond_to?(:cover_image) && project.cover_image.attached? %>
                    <%= image_tag project.cover_image.variant(resize_to_fill: [640, 360]), alt: "Capture d'écran du projet #{project.title}", class: "project-card-thumb__image", loading: "lazy" %>
                  <% else %>
                    <div class="project-card-thumb__placeholder" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                        <circle cx="9" cy="9" r="2"></circle>
                        <path d="m21 15-5-5L5 21"></path>
                      </svg>
                    </div>
                  <% end %>
                </div>

                <header class="project-card-head">
                  <div class="card-title">
                    <h2 style="view-transition-name: project-<%= project.id %>-title;"><%= project.title %></h2>
                    <div class="project-subtitle">
                      <span class="jp-subtitle"><%= project.role_jp %></span>
                      <span class="project-highlight">— <%= project.role_description %></span>
                    </div>
                  </div>

                  <div class="social-icons">
                    <% if project.github_url.present? %>
                      <%= link_to project.github_url, class: "social-icon", target: "_blank", rel: "noopener noreferrer", data: { turbo: false }, aria: { label: "Voir le code source de #{project.title} sur GitHub" } do %>
                        <img src="https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/github.svg" alt="" class="social-icon__brand-icon" loading="lazy">
                      <% end %>
                    <% end %>
                    <% if project.demo_url.present? %>
                      <%= link_to project.demo_url, class: "social-icon", target: "_blank", rel: "noopener noreferrer", data: { turbo: false }, aria: { label: "Voir la démo de #{project.title}" } do %>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                          <polyline points="15 3 21 3 21 9"></polyline>
                          <line x1="10" y1="14" x2="21" y2="3"></line>
                        </svg>
                      <% end %>
                    <% end %>
                  </div>
                </header>

                <div class="project-card-body">
                  <p class="tagline"><%= project.tagline %></p>

                  <span class="challenge-title">Défis techniques</span>
                  <p class="challenge"><%= project.challenges %></p>

                  <ul class="stack">
                    <% project.stack.split(",").each do |techno| %>
                      <li class="techno">
                        <%= link_to techno.strip, projects_path(tag: techno.strip), data: { turbo_prefetch: true } %>
                      </li>
                    <% end %>
                  </ul>
                </div>

                <footer class="project-card-footer">
                  <div class="results">
                    <% project.results.split(",").first(3).each do |result| %>
                      <div class="result-pill">
                        <div class="results-square" aria-hidden="true"></div>
                        <span class="result"><%= result.strip %></span>
                      </div>
                    <% end %>
                  </div>

                  <%= link_to project_path(project), class: "details-link", data: { turbo_prefetch: true } do %>
                    Détails
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  <% end %>
                </footer>
              </article>
            <% end %>
          </div>

          <button
            type="button"
            class="projects-carousel__arrow projects-carousel__arrow--next"
            data-carousel-target="nextButton"
            data-action="click->carousel#next"
            aria-label="Réalisations suivantes"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      <% end %>

    </div>
  </section>
</div>
