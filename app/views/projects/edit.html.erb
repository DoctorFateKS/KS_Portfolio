<div class="page-content">
  <section class="page-section">
    <div class="halftone" aria-hidden="true"></div>
    <div class="action-lines" aria-hidden="true"></div>

    <div class="container">

      <%= link_to project_path(@project), class: "header back-link" do %>
        <div class="header-line"></div>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="back-link__icon" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span class="header-jp">戻る</span>
        <span class="header-en">Retour à <%= @project.title %></span>
      <% end %>

      <h1 class="projects-title"><span class="fg">Modifier</span> <span class="highlight"><%= @project.title %></span></h1>

      <%= render "form", project: @project %>

      <div class="danger-zone">
        <h2 class="danger-zone__title">Zone de suppression</h2>
        <p class="danger-zone__text">Cette action est irréversible : la réalisation et son image de couverture seront définitivement supprimées.</p>
        <%= button_to "Supprimer cette réalisation",
              project_path(@project),
              method: :delete,
              class: "hero__btn hero__btn--danger",
              data: { turbo_confirm: "Supprimer définitivement « #{@project.title} » ? Cette action est irréversible." } %>
      </div>

    </div>
  </section>
</div>
