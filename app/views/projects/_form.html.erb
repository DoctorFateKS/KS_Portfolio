<%= form_with(model: project, class: "project-form") do |form| %>
  <% if project.errors.any? %>
    <div class="error-messages">
      <h2><%= pluralize(project.errors.count, "erreur") %> empêchent la sauvegarde :</h2>
      <ul><% project.errors.each do |error| %><li><%= error.full_message %></li><% end %></ul>
    </div>
  <% end %>

  <div class="form-grid">
    <%# --- Section Header & Banner --- %>
    <fieldset>
      <legend>Identité du Projet</legend>
      <div class="field">
        <%= form.label :title, "Titre du projet" %>
        <%= form.text_field :title, placeholder: "Ex: ShareFriends" %>
      </div>

      <div class="field">
        <%= form.label :status, "Badge Status" %>
        <%= form.text_field :status, placeholder: "Ex: Mis en avant, En développement..." %>
      </div>

      <div class="field">
        <%= form.label :tagline, "Slogan accrocheur" %>
        <%= form.text_field :tagline, placeholder: "Recréer du lien social par l'affinité..." %>
      </div>

      <div class="field">
        <%= form.label :banner, "Image de bannière" %>
        <%= form.file_field :banner %>
      </div>
    </fieldset>

    <%# --- Section Contenu Principal --- %>
    <fieldset>
      <legend>Détails Techniques & Rôle</legend>
      <div class="field">
        <%= form.label :context, "Contexte & Problématique" %>
        <%= form.text_area :context, rows: 4 %>
      </div>

      <div class="field">
        <%= form.label :role_description, "Ton Rôle (Fullstack, Lead...)" %>
        <%= form.text_area :role_description, rows: 3 %>
      </div>

      <div class="field">
        <%= form.label :stack, "Stack Technique (séparer par des virgules ,)" %>
        <%= form.text_field :stack, placeholder: "Ruby, Rails, Hotwire, PostgreSQL" %>
      </div>
    </fieldset>

    <%# --- Section Architecture & Défis --- %>
    <fieldset>
      <legend>Architecture & Réalisation</legend>
      <div class="field">
        <%= form.label :usage_decisions, "Choix d'Architecture (séparer par des points-virgules ;)" %>
        <%= form.text_area :usage_decisions, placeholder: "Auth avec Devise; Background jobs avec Sidekiq..." %>
      </div>

      <div class="field">
        <%= form.label :challenges, "Défis rencontrés (séparer par des points-virgules ;)" %>
        <%= form.text_area :challenges, placeholder: "Latence WebSocket; Sécurité des données..." %>
      </div>

      <div class="field">
        <%= form.label :solutions, "Solutions apportées (séparer par des points-virgules ;)" %>
        <%= form.text_area :solutions, placeholder: "Optimisation Redis; Pundit pour les accès..." %>
      </div>
    </fieldset>

    <%# --- Section Impact & Liens --- %>
    <fieldset>
      <legend>Impact & Liens Externes</legend>
      <div class="field">
        <%= form.label :impact_quote, "Citation / Résultat final" %>
        <%= form.text_area :impact_quote, rows: 2 %>
      </div>

      <div class="field">
        <%= form.label :github_url, "Lien GitHub" %>
        <%= form.url_field :github_url %>
      </div>

      <div class="field">
        <%= form.label :demo_url, "Lien Démo / Vidéo" %>
        <%= form.url_field :demo_url %>
      </div>

      <div class="field checkbox">
        <%= form.check_box :featured %>
        <%= form.label :featured, "Mettre en avant sur la page d'accueil" %>
      </div>
    </fieldset>
  </div>

  <div class="form-actions" style="margin-top: 30px;">
    <%= form.submit "Enregistrer le projet", class: "btn-action btn-action--accent" %>
  </div>
<% end %>
