<div class="navbar-root" data-controller="navbar" data-navbar-pages-value="<%= [root_path, pages_profil_path, pages_skills_path, projects_path, blogs_path].to_json %>">

  <%= link_to root_path, class: "navbar-brand", data: { action: "click->navbar#close", turbo_prefetch: true } do %>
    <span class="navbar-brand__text">ルビー</span>
    <span class="navbar-brand__subtitle">KS</span>
  <% end %>

  <button
    class="navbar-toggle"
    data-navbar-target="button"
    data-action="click->navbar#toggle keydown.esc->navbar#close"
    aria-expanded="false"
    aria-controls="navbar-overlay"
    aria-label="Ouvrir le menu de navigation"
  >
    <span class="hamburger" data-navbar-target="hamburger" aria-hidden="true"></span>
  </button>

  <div
    id="navbar-overlay"
    class="navbar-overlay"
    data-navbar-target="overlay"
    role="dialog"
    aria-modal="true"
    aria-label="Menu principal"
    inert
  >
    <div class="navbar-overlay__halftone" aria-hidden="true"></div>

    <nav class="navbar-overlay__nav" aria-label="Navigation principale">
      <a href="<%= root_path %>" class="navbar-overlay__link" data-navbar-target="link" data-action="click->navbar#close" data-turbo-prefetch="true">
        <span class="navbar-overlay__index">01</span>
        <span class="navbar-overlay__jp">ホームページ</span>
        <span class="navbar-overlay__en">Accueil</span>
      </a>
      <a href="<%= pages_profil_path %>" class="navbar-overlay__link" data-navbar-target="link" data-action="click->navbar#close" data-turbo-prefetch="true">
        <span class="navbar-overlay__index">02</span>
        <span class="navbar-overlay__jp">紹介</span>
        <span class="navbar-overlay__en">À propos</span>
      </a>
      <a href="<%= pages_skills_path %>" class="navbar-overlay__link" data-navbar-target="link" data-action="click->navbar#close" data-turbo-prefetch="true">
        <span class="navbar-overlay__index">03</span>
        <span class="navbar-overlay__jp">技術</span>
        <span class="navbar-overlay__en">Compétences</span>
      </a>
      <a href="<%= projects_path %>" class="navbar-overlay__link" data-navbar-target="link" data-action="click->navbar#close" data-turbo-prefetch="true">
        <span class="navbar-overlay__index">04</span>
        <span class="navbar-overlay__jp">作品</span>
        <span class="navbar-overlay__en">Réalisations</span>
      </a>
      <a href="<%= blogs_path %>" class="navbar-overlay__link" data-navbar-target="link" data-action="click->navbar#close" data-turbo-prefetch="true">
        <span class="navbar-overlay__index">05</span>
        <span class="navbar-overlay__jp">ブログ</span>
        <span class="navbar-overlay__en">Journal</span>
      </a>
    </nav>

    <a href="mailto:saisonkevin@protonmail.com" class="navbar-overlay__cta manga-slash" data-navbar-target="link" data-action="click->navbar#close" data-turbo-prefetch="false">
      Parlons de votre projet
    </a>
  </div>

  <div class="page-indicator" data-navbar-target="indicator" aria-hidden="true"></div>
</div>

<noscript>
  <nav class="navbar-noscript" aria-label="Navigation principale (sans JavaScript)">
    <%= link_to "Accueil", root_path %>
    <%= link_to "À propos", pages_profil_path %>
    <%= link_to "Compétences", pages_skills_path %>
    <%= link_to "Réalisations", projects_path %>
    <%= link_to "Journal", blogs_path %>
  </nav>
</noscript>
