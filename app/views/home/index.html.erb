<section class="hero">

  <div class="hero__image-container">
    <div class="hero__image-gradient"></div>
    <%= image_tag "hero-background.jpeg", alt: "Ruby gemstone manga art", class: "hero__image" %>
  </div>

  <div class="hero__container">
    <div class="hero__content">
      <div class="hero__badge">
        <div class="hero__badge-line"></div>
        <span class="hero__badge-text">開発者</span>
      </div>

      <h1 class="hero__title">
        <span class="hero__title-line">Kevin</span>
        <span class="hero__title-line hero__title-primary">Saison</span>
        <span class="hero__title-line">Ruby & Rails</span>
      </h1>

      <p class="hero__description">
        Le <span class="hero__highlight">FUTUR</span> du développement Ruby & Ruby on Rails. Et ce n'est pas seulement <span class="hero__highlight">MOI</span> qui le dit. <span class="hero__highlight">GOOGLE</span> le dit !  <span class="hero__highlight">APPLE</span> le dit ! (ou pas... encore !)
      </p>

      <div class="hero__cta-buttons">
        <%# <a href="#projects" class="hero__btn hero__btn--primary manga-slash">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hero__icon">
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
          Voir mes talents
        </a> %>
        <a href="mailto:saisonkevin@protonmail.com" class="hero__btn hero__btn--secondary manga-panel">Un p'tit message ?</a>
      </div>
    </div>
  </div>
</section>
