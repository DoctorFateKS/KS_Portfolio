<section class="secondary-section">
  <div class="halftone"></div>
  <div class="action-lines"></div>

  <div class="container">
    <div class="header">
      <div class="header-line"></div>
			<span class="header-jp">ブログ</span>
			<span class="header-en">Blog</span>
		</div>

    <h1 class="skills-title"><span class="fg">Journal</span> <span class="highlight">Intime</span></h1>

    <div class="blog-grid">
      <% @blogs.each do |article| %>
        <%= link_to blog_path(article), class:"article_link" do %>
          <article class="skills-card">
            <div class="card-ribbon"></div>
            <header class="project-card-head">
              <div class="card-title">
                <span class="jp-subtitle"><%= article.jp_title %></span>
                <h3><%= article.title %></h3>
              </div>
            </header>
            <div class="project-card-body">
              <p class="tagline"><%= article.content.first(150) %>...</p>
              <div class="stack">
                <p>
                  <% article.tags.split(",").each do |tag| %>
                    <span class="techno"><%= tag %></span>
                  <% end %>
                </p>
              </div>
            </div>
            <footer class="project-card-footer">
              <p> 🗓️ <%= article.created_at.strftime("%d/%m/%Y") %> 🕜 <%= (article.content.length / 1200.0).round %>min</p>
            </footer>
          </article>
        <% end %>
      <% end %>
    </div>
  </div>
</section>
