<section class="blog-header-section">
  <header class="blog-hero">
    <div class="blog-badge">
      <span class="icon-book">📖</span> Technical Blog
    </div>
    <h1 class="blog-title">Insights & <span class="text--red">Deep Dives</span></h1>
    <p class="blog-subtitle">
      In-depth articles on Ruby, Rails, and software engineering. Practical guides, performance tips, and lessons learned from real-world projects.
    </p>
  </header>

  <!-- Create New Article Button -->
  <div class="blog-admin-bar">
    <%= link_to '✨ Create New Article', new_blog_path, class: 'btn btn--create' %>
  </div>

  <!-- Search & Filter Controls -->
  <div class="blog-controls">
    <%= form_with url: blogs_path, method: :get, local: true, class: 'search-form' do |f| %>
      <div class="search-wrapper">
        <span class="search-icon">🔍</span>
        <%= f.text_field :q, placeholder: 'Search articles, topics, tags...', class: 'search-input', value: @search_query %>
      </div>

      <nav class="filter-nav">
        <ul class="filter-list">
          <li>
            <%= link_to 'All', blogs_path(q: @search_query), class: "filter-item #{'filter-item--active' if @category_filter.blank?}" %>
          </li>
          <% @categories.each do |category| %>
            <li>
              <%= link_to category, blogs_path(category: category, q: @search_query),
                  class: "filter-item #{'filter-item--active' if @category_filter == category}" %>
            </li>
          <% end %>
        </ul>
      </nav>

      <div class="search-submit">
        <%= f.submit 'Search', class: 'btn btn--search' %>
      </div>
    <% end %>
  </div>
</section>

<section class="featured-articles">
  <header class="articles-section-header">
    <h2 class="articles-section-title">
      <span class="icon-trending">📈</span> Featured Articles
    </h2>
  </header>

  <% if @featured_blogs.any? %>
    <div class="articles-grid">
      <% @featured_blogs.first(2).each_with_index do |blog, index| %>
        <article class="article-card <%= index == 0 ? 'border-red' : 'border-grey' %>">
          <div class="article-card__header">
            <% if blog.banner.attached? %>
              <div class="article-visual" style="background-image: url('<%= url_for(blog.banner) %>')">
              </div>
            <% else %>
              <div class="article-visual">
                <span>📑</span>
              </div>
            <% end %>
            <span class="badge-featured">Featured</span>
          </div>

          <div class="article-card__body">
            <span class="category-pill"><%= link_to blog.category, blogs_path(category: blog.category) %></span>
            <h3 class="article-title"><%= link_to blog.title, blog_path(blog) %></h3>
            <p class="article-excerpt"><%= blog.excerpt_display %></p>

            <% if blog.tags_list.any? %>
              <div class="article-tags">
                <% blog.tags_list.first(3).each do |tag| %>
                  <span class="tag"><%= link_to tag, blogs_path(q: tag) %></span>
                <% end %>
              </div>
            <% end %>
          </div>

          <footer class="article-card__footer">
            <div class="meta-left">
              <span>📅 <%= blog.published_date %></span>
              <span>⏱️ <%= blog.reading_time_minutes %> min read</span>
            </div>
            <div class="meta-right">
              <span class="view-count"><%= number_with_delimiter(blog.view_count) %> views</span>
            </div>
          </footer>

          <div class="article-card__actions">
            <%= link_to 'Read', blog_path(blog), class: 'action-link action-link--read' %>
            <%= link_to 'Edit', edit_blog_path(blog), class: 'action-link action-link--edit' %>
            <%= button_to 'Delete', blog_path(blog), method: :delete, data: { confirm: 'Are you sure?' }, class: 'action-link action-link--delete' %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <p class="empty-state-icon">📝</p>
      <p class="empty-state-text">No featured articles yet. <%= link_to 'Create one!', new_blog_path %></p>
    </div>
  <% end %>
</section>

<section class="all-articles-section">
  <header class="all-articles-header">
    <h2 class="all-articles-title">
      <span class="icon-code">< ></span> All Articles
    </h2>
    <span class="article-count"><%= @total_count %> article<%= 's' if @total_count != 1 %></span>
  </header>

  <% if @blogs.any? %>
    <div class="all-articles-grid">
      <% @blogs.each do |blog| %>
        <article class="mini-article-card">
          <div class="mini-article-top">
            <% if blog.published %>
              <span class="published-indicator">🟢</span>
            <% else %>
              <span class="published-indicator unpublished">🔴</span>
            <% end %>
            <span class="mini-article-category"><%= link_to blog.category, blogs_path(category: blog.category) %></span>
          </div>

          <h3 class="mini-article-title"><%= link_to blog.title, blog_path(blog) %></h3>
          <p class="mini-article-excerpt"><%= blog.excerpt_display %></p>

          <% if blog.tags_list.any? %>
            <div class="mini-article-tags">
              <% blog.tags_list.first(2).each do |tag| %>
                <span class="mini-tag"><%= link_to tag, blogs_path(q: tag) %></span>
              <% end %>
              <% if blog.tags_list.size > 2 %>
                <span class="mini-tag">+<%= blog.tags_list.size - 2 %></span>
              <% end %>
            </div>
          <% end %>

          <footer class="mini-article-footer">
            <div class="footer-left">
              <span>📅 <%= blog.published_date %></span>
              <span>⏱️ <%= blog.reading_time_minutes %> min</span>
            </div>
            <div class="footer-right">
              <span>👁️ <%= number_with_delimiter(blog.view_count) %></span>
            </div>
          </footer>

          <div class="mini-article-actions">
            <%= link_to 'Read', blog_path(blog), class: 'mini-action-btn mini-action-btn--read' %>
            <%= link_to 'Edit', edit_blog_path(blog), class: 'mini-action-btn mini-action-btn--edit' %>
            <%= button_to 'Delete', blog_path(blog), method: :delete, data: { confirm: 'Are you sure?' }, class: 'mini-action-btn mini-action-btn--delete', form: { style: 'display: inline;' } %>
          </div>
        </article>
      <% end %>
    </div>

    <!-- Pagination -->
    <% if @total_pages > 1 %>
      <div class="pagination-wrapper">
        <nav class="pagination">
          <% if @current_page > 1 %>
            <%= link_to '← Previous', blogs_path(q: @search_query, category: @category_filter, page: @current_page - 1), class: 'pagination-link pagination-link--prev' %>
          <% end %>

          <div class="pagination-numbers">
            <% (1..@total_pages).each do |page| %>
              <% if page == @current_page %>
                <span class="pagination-number pagination-number--active"><%= page %></span>
              <% elsif (page == 1) || (page == @total_pages) || (page >= @current_page - 1 && page <= @current_page + 1) %>
                <%= link_to page, blogs_path(q: @search_query, category: @category_filter, page: page), class: 'pagination-number' %>
              <% elsif page == 2 || page == @total_pages - 1 %>
                <span class="pagination-ellipsis">...</span>
              <% end %>
            <% end %>
          </div>

          <% if @current_page < @total_pages %>
            <%= link_to 'Next →', blogs_path(q: @search_query, category: @category_filter, page: @current_page + 1), class: 'pagination-link pagination-link--next' %>
          <% end %>
        </nav>
      </div>
    <% end %>
  <% else %>
    <div class="empty-state">
      <% if @search_query.present? || @category_filter.present? %>
        <p class="empty-state-icon">🔍</p>
        <p class="empty-state-text">
          No articles found matching your search.
          <%= link_to 'Clear filters', blogs_path, class: 'empty-state-link' %>
        </p>
      <% else %>
        <p class="empty-state-icon">✍️</p>
        <p class="empty-state-text">
          No articles yet. <%= link_to 'Start writing!', new_blog_path, class: 'empty-state-link' %>
        </p>
      <% end %>
    </div>
  <% end %>
</section>

<section class="writing-philosophy">
  <header class="philosophy-header">
    <h2 class="philosophy-title">Writing Philosophy</h2>
    <p class="philosophy-subtitle">Every article follows these principles to maximize educational value</p>
  </header>

  <div class="philosophy-grid">
    <div class="philosophy-card">
      <div class="philosophy-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
      </div>
      <h3 class="principle-name">Clear Code Examples</h3>
      <p class="principle-desc">Well-commented, production-ready code snippets that you can use directly in your projects.</p>
    </div>

    <div class="philosophy-card">
      <div class="philosophy-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
      </div>
      <h3 class="principle-name">Practical Focus</h3>
      <p class="principle-desc">Real-world problems and solutions, not theoretical exercises or "hello world" demos.</p>
    </div>

    <div class="philosophy-card">
      <div class="philosophy-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      </div>
      <h3 class="principle-name">Educational Tone</h3>
      <p class="principle-desc">Concepts explained from first principles, making complex topics accessible to all skill levels.</p>
    </div>
  </div>
</section>

<section class="newsletter-section">
  <div class="newsletter-card">
    <header class="newsletter-header">
      <span class="newsletter-badge">Stay Updated</span>
      <h2 class="newsletter-title">Get New Articles Delivered</h2>
      <p class="newsletter-subtitle">
        Subscribe to receive notifications about new articles, tutorials, and deep dives into Ruby, Rails, and software engineering.
      </p>
    </header>

    <%= form_with url: "#", class: "newsletter-form" do |f| %>
      <div class="input-group">
        <%= f.email_field :email, placeholder: "your@email.com", class: "newsletter-input", required: true %>
        <%= f.submit "Subscribe", class: "btn-subscribe" %>
      </div>
      <p class="newsletter-disclaimer">
        No spam, unsubscribe anytime. Usually 1-2 emails per month.
      </p>
    <% end %>
  </div>
</section>
