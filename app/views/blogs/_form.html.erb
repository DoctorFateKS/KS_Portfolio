<%= form_with model: blog, class: "blog-form" do |f| %>

  <% if blog.errors.any? %>
    <div class="form-errors">
      <p class="form-errors__title">
        <%= pluralize(blog.errors.count, "erreur") %> empêche l'enregistrement :
      </p>
      <ul>
        <% blog.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :title, "Titre" %>
    <%= f.text_field :title, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :jp_title, "Titre (japonais)" %>
    <%= f.text_field :jp_title, placeholder: "ex : 技術ノート" %>
  </div>

  <div class="form-group">
    <%= f.label :tags, "Tags" %>
    <span class="form-hint">Séparés par des virgules, ex : Ruby, Rails, PostgreSQL</span>
    <%= f.text_field :tags, placeholder: "Ruby, Rails, PostgreSQL" %>
  </div>

  <div class="form-group">
    <%= f.label :content, "Contenu (Markdown)" %>

    <details class="markdown-cheatsheet">
      <summary>Aide-mémoire Markdown</summary>
      <table>
        <tbody>
          <tr>
            <td><code># Titre</code> / <code>## Sous-titre</code></td>
            <td>Titres (niveaux 1 à 6, autant de <code>#</code>)</td>
          </tr>
          <tr>
            <td><code>**gras**</code></td>
            <td><strong>gras</strong></td>
          </tr>
          <tr>
            <td><code>*italique*</code></td>
            <td><em>italique</em></td>
          </tr>
          <tr>
            <td><code>~~barré~~</code></td>
            <td><del>barré</del></td>
          </tr>
          <tr>
            <td><code>[texte](https://exemple.com)</code></td>
            <td>Lien</td>
          </tr>
          <tr>
            <td><code>- item</code></td>
            <td>Liste à puces (une ligne par item)</td>
          </tr>
          <tr>
            <td><code>1. item</code></td>
            <td>Liste numérotée</td>
          </tr>
          <tr>
            <td><code>&gt; citation</code></td>
            <td>Citation en retrait</td>
          </tr>
          <tr>
            <td><code>`code en ligne`</code></td>
            <td>Code court dans une phrase</td>
          </tr>
          <tr>
            <td>```` ```ruby ... ``` ````</td>
            <td>Bloc de code avec coloration syntaxique (indique le langage après les backticks)</td>
          </tr>
          <tr>
            <td><code>| Col A | Col B |</code><br><code>|---|---|</code><br><code>| val | val |</code></td>
            <td>Tableau</td>
          </tr>
          <tr>
            <td><code>---</code></td>
            <td>Ligne de séparation horizontale</td>
          </tr>
          <tr>
            <td><code>\( E = mc^2 \)</code></td>
            <td>Équation en ligne (LaTeX, rendue par KaTeX)</td>
          </tr>
          <tr>
            <td><code>\[ \int_0^1 x^2\,dx \]</code></td>
            <td>Équation en bloc, centrée</td>
          </tr>
        </tbody>
      </table>
    </details>

    <%= f.text_area :content, rows: 20, class: "blog-form__content" %>
  </div>

  <div class="form-actions">
    <%= f.submit blog.new_record? ? "Publier l'article" : "Enregistrer les modifications", class: "hero__btn hero__btn--primary" %>
    <%= link_to "Annuler", blogs_path, class: "hero__btn hero__btn--secondary manga-panel" %>
  </div>

<% end %>
