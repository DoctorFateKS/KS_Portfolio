<section class="secondary-section">
  <div class="halftone"></div>
  <div class="action-lines"></div>

  <div class="container">
    <h1>Editer Article</h1>
    <%= form_with model: @blog do |form| %>
      <div>
        <%= form.label :title %>
        <%= form.text_field :title %>
      </div>

      <div>
        <%= form.label :jp_title %>
        <%= form.text_field :jp_title %>
      </div>

      <div>
        <%= form.label :tags %>
        <%= form.text_field :tags %>
      </div>

      <div>
        <%= form.label :content %>
        <%= form.hidden_field :content, id: "blog_content" %>
        <trix-editor input="blog_content"></trix-editor>
      </div>

      <div>
        <%= form.submit %>
      </div>
    <% end %>
  </div>
</section>

