<section class="main-section">
  <div class="halftone"></div>
  <div class="action-lines"></div>

  <div class="container">
    <%= link_to blogs_path, class: "back_link" do %>⭠ Retour<% end %>

    <h1 class="skills-title"><span class="highlight"><%= @blog.title %></span></h1>
    <p> 🗓️ <%= @blog.created_at.strftime("%d/%m/%Y") %> 🕜 <%= (@blog.content.length / 1200.0).round %>min</p>
    <% @blog.tags.split(",").each do |tag| %> <span class="techno"><%= tag %></span> <% end %>

    <div class="content">
      <%= highlight_code(@blog.content) %>
    </div>
  </div>
</section>
