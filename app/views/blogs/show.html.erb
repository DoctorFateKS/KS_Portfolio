<div class="blog-show-container">
  <!-- Back to Blog Navigation -->
  <nav class="breadcrumb-nav">
    <div class="breadcrumb-wrapper">
      <%= link_to '← Back to Blog', blogs_path, class: 'breadcrumb-link' %>
    </div>
  </nav>

  <!-- Article Header -->
  <article class="article-show">
    <header class="article-show__header">
      <div class="article-show__meta">
        <span class="category-badge category--<%= @blog.category.downcase.gsub('-', '_') %>">
          <%= @blog.category %>
        </span>
        <time class="published-date">📅 <%= @blog.published_date %></time>
        <span class="reading-time">⏱️ <%= @blog.reading_time_minutes %> min read</span>
        <span class="view-count">👁️ <%= number_with_delimiter(@blog.view_count) %> views</span>
      </div>

      <h1 class="article-show__title"><%= @blog.title %></h1>

      <p class="article-show__excerpt"><%= @blog.excerpt %></p>

      <% if @blog.tags_list.any? %>
        <div class="article-tags">
          <% @blog.tags_list.each do |tag| %>
            <span class="tag tag--clickable" onclick="window.location.href = '<%= blogs_path(q: tag, page: 1) %>'">
              <%= tag %>
            </span>
          <% end %>
        </div>
      <% end %>
    </header>

    <!-- Article Banner Image -->
    <% if @blog.banner.attached? %>
      <div class="article-show__banner">
        <%= image_tag @blog.banner, alt: @blog.title, class: 'article-banner-image' %>
      </div>
    <% else %>
      <div class="article-show__banner article-show__banner--placeholder">
        <div class="placeholder-content">
          <span class="placeholder-icon">📰</span>
          <p>No banner image</p>
        </div>
      </div>
    <% end %>

    <!-- Article Content -->
    <div class="article-show__content">
      <div class="prose prose--article">
        <%= simple_format(@blog.content) %>
      </div>
    </div>

    <!-- Article Footer with Actions -->
    <footer class="article-show__footer">
      <div class="article-actions">
        <%= link_to 'Edit Article', edit_blog_path(@blog), class: 'btn btn--secondary btn--sm' %>
        <%= button_to 'Delete Article', blog_path(@blog), method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn--danger btn--sm' %>
      </div>
    </footer>
  </article>

  <!-- Related Articles Section -->
  <% if @related_blogs.any? %>
    <section class="related-articles">
      <h2 class="section-title">📚 Related Articles</h2>
      <div class="related-articles-grid">
        <% @related_blogs.each do |blog| %>
          <div class="article-card-related">
            <div class="article-card-related__header">
              <span class="category-pill"><%= blog.category %></span>
            </div>
            <div class="article-card-related__body">
              <h3 class="article-card-related__title"><%= link_to blog.title, blog_path(blog) %></h3>
              <p class="article-card-related__excerpt"><%= blog.excerpt_display %></p>
            </div>
            <div class="article-card-related__footer">
              <span>⏱️ <%= blog.reading_time_minutes %> min</span>
              <span>👁️ <%= number_with_delimiter(blog.view_count) %></span>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
</div>

<style>
  .blog-show-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 40px 20px;
    color: #fff;
  }

  .breadcrumb-nav {
    margin-bottom: 40px;
  }

  .breadcrumb-link {
    color: #ff0000;
    text-decoration: none;
    font-weight: 600;
    transition: opacity 0.3s ease;
    display: inline-block;
  }

  .breadcrumb-link:hover {
    opacity: 0.8;
  }

  .article-show__header {
    margin-bottom: 40px;
  }

  .article-show__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    align-items: center;
    margin-bottom: 20px;
    font-size: 0.95rem;
    color: #888;
  }

  .category-badge {
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .category--performance { background-color: rgba(255, 100, 100, 0.15); color: #ff6464; border: 1px solid rgba(255, 100, 100, 0.3); }
  .category--architecture { background-color: rgba(100, 150, 255, 0.15); color: #6496ff; border: 1px solid rgba(100, 150, 255, 0.3); }
  .category--tutorial { background-color: rgba(100, 255, 150, 0.15); color: #64ff96; border: 1px solid rgba(100, 255, 150, 0.3); }
  .category--deep-dive { background-color: rgba(255, 200, 100, 0.15); color: #ffc864; border: 1px solid rgba(255, 200, 100, 0.3); }
  .category--testing { background-color: rgba(200, 100, 255, 0.15); color: #c864ff; border: 1px solid rgba(200, 100, 255, 0.3); }
  .category--database { background-color: rgba(100, 255, 255, 0.15); color: #64ffff; border: 1px solid rgba(100, 255, 255, 0.3); }
  .category--refactoring { background-color: rgba(150, 100, 255, 0.15); color: #9664ff; border: 1px solid rgba(150, 100, 255, 0.3); }
  .category--devops { background-color: rgba(255, 150, 100, 0.15); color: #ff9664; border: 1px solid rgba(255, 150, 100, 0.3); }
  .category--security { background-color: rgba(255, 100, 150, 0.15); color: #ff6496; border: 1px solid rgba(255, 100, 150, 0.3); }
  .category--other { background-color: rgba(150, 150, 150, 0.15); color: #999; border: 1px solid rgba(150, 150, 150, 0.3); }

  .article-show__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 20px;
    letter-spacing: -0.5px;
  }

  .article-show__excerpt {
    font-size: 1.2rem;
    color: #ccc;
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 40px;
  }

  .tag {
    display: inline-block;
    padding: 6px 12px;
    background: rgba(255, 0, 0, 0.1);
    color: #ff6464;
    border: 1px solid rgba(255, 100, 100, 0.3);
    border-radius: 15px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .tag--clickable {
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .tag--clickable:hover {
    background: rgba(255, 0, 0, 0.2);
    border-color: rgba(255, 100, 100, 0.6);
  }

  .article-show__banner {
    width: 100%;
    height: 400px;
    border-radius: 12px;
    overflow: hidden;
    margin: 40px 0;
    background: linear-gradient(135deg, rgba(255, 0, 0, 0.1), rgba(255, 0, 0, 0.05));
    border: 1px solid rgba(255, 100, 100, 0.2);
  }

  .article-show__banner--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .placeholder-content {
    text-align: center;
  }

  .placeholder-icon {
    font-size: 4rem;
    display: block;
    margin-bottom: 10px;
  }

  .placeholder-content p {
    color: #666;
  }

  .article-banner-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-show__content {
    margin: 60px 0;
    line-height: 1.8;
  }

  .prose {
    font-size: 1.05rem;
    color: #ddd;
  }

  .prose p {
    margin-bottom: 1.5rem;
  }

  .prose h2, .prose h3, .prose h4 {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-weight: 700;
    color: #fff;
  }

  .prose h2 { font-size: 1.8rem; }
  .prose h3 { font-size: 1.5rem; }
  .prose h4 { font-size: 1.25rem; }

  .prose ul, .prose ol {
    margin: 1.5rem 0;
    padding-left: 2rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose code {
    background: rgba(255, 0, 0, 0.1);
    color: #ff6464;
    padding: 2px 6px;
    border-radius: 4px;
    font-family: 'Monaco', 'Menlo', monospace;
  }

  .prose pre {
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 100, 100, 0.2);
    border-radius: 8px;
    padding: 1.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .prose pre code {
    background: none;
    color: #64ff96;
    padding: 0;
    font-size: 0.9rem;
  }

  .article-show__footer {
    margin-top: 60px;
    padding-top: 30px;
    border-top: 1px solid rgba(255, 100, 100, 0.2);
  }

  .article-actions {
    display: flex;
    gap: 12px;
  }

  .btn {
    padding: 10px 20px;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 0.95rem;
  }

  .btn--secondary {
    background: rgba(255, 100, 100, 0.1);
    color: #ff6464;
    border: 1px solid rgba(255, 100, 100, 0.3);
  }

  .btn--secondary:hover {
    background: rgba(255, 100, 100, 0.2);
  }

  .btn--danger {
    background: rgba(255, 50, 50, 0.15);
    color: #ff3232;
    border: 1px solid rgba(255, 50, 50, 0.4);
  }

  .btn--danger:hover {
    background: rgba(255, 50, 50, 0.25);
  }

  .btn--sm {
    padding: 8px 16px;
    font-size: 0.9rem;
  }

  .related-articles {
    margin-top: 80px;
    padding-top: 40px;
    border-top: 1px solid rgba(255, 100, 100, 0.2);
  }

  .section-title {
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 30px;
  }

  .related-articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
  }

  .article-card-related {
    background: rgba(255, 0, 0, 0.05);
    border: 1px solid rgba(255, 100, 100, 0.2);
    border-radius: 8px;
    padding: 20px;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .article-card-related:hover {
    border-color: rgba(255, 100, 100, 0.5);
    background: rgba(255, 0, 0, 0.08);
    transform: translateY(-2px);
  }

  .article-card-related__body {
    flex: 1;
    margin-bottom: 15px;
  }

  .article-card-related__title {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .article-card-related__title a {
    color: #fff;
    text-decoration: none;
  }

  .article-card-related__title a:hover {
    color: #ff6464;
  }

  .article-card-related__excerpt {
    font-size: 0.95rem;
    color: #aaa;
    line-height: 1.5;
  }

  .article-card-related__footer {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    color: #888;
  }

  @media (max-width: 768px) {
    .article-show__title {
      font-size: 2rem;
    }

    .article-show__banner {
      height: 250px;
    }

    .related-articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
