<!DOCTYPE html>
<html>
  <head>
    <style>
      body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; line-height: 1.6; color: #333; }
      .container { max-width: 600px; margin: 0 auto; padding: 20px; }
      .header { background: #ff0000; color: white; padding: 20px; border-radius: 8px 8px 0 0; }
      .content { background: white; padding: 30px; border: 1px solid #ddd; }
      .field { margin-bottom: 20px; }
      .label { font-weight: bold; color: #ff0000; text-transform: uppercase; font-size: 12px; letter-spacing: 1px; }
      .value { padding: 10px; background: #f9f9f9; border-left: 3px solid #ff0000; margin-top: 5px; }
      .footer { background: #f0f0f0; padding: 15px; text-align: center; font-size: 12px; border-radius: 0 0 8px 8px; }
      .cta-btn { display: inline-block; background: #ff0000; color: white; padding: 12px 24px; text-decoration: none; border-radius: 4px; margin-top: 20px; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>New Contact Form Submission</h1>
      </div>

      <div class="content">
        <div class="field">
          <div class="label">From</div>
          <div class="value"><strong><%= @contact.name %></strong></div>
        </div>

        <div class="field">
          <div class="label">Email</div>
          <div class="value"><a href="mailto:<%= @contact.email %>"><%= @contact.email %></a></div>
        </div>

        <% if @contact.company.present? %>
          <div class="field">
            <div class="label">Company</div>
            <div class="value"><%= @contact.company %></div>
          </div>
        <% end %>

        <div class="field">
          <div class="label">Project Type</div>
          <div class="value"><%= @contact.project_type.humanize %></div>
        </div>

        <div class="field">
          <div class="label">Submitted</div>
          <div class="value"><%= @contact.created_at.strftime('%B %d, %Y at %H:%M UTC') %></div>
        </div>

        <div class="field">
          <div class="label">Message</div>
          <div class="value" style="white-space: pre-wrap; line-height: 1.8;">
            <%= simple_format(@contact.message) %>
          </div>
        </div>

        <div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid #eee;">
          <p><strong>IP Address:</strong> <%= @contact.ip_address %></p>
          <a href="mailto:<%= @contact.email %>" class="cta-btn">Reply to <%= @contact.name %></a>
        </div>
      </div>

      <div class="footer">
        <p>Contact form submission from your portfolio</p>
      </div>
    </div>
  </body>
</html>
